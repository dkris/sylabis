# sylabis configuration. `sy init` writes ANTHROPIC_API_KEY into
# $SYLABIS_HOME/.env (default ~/sylabis/.env) for you — this file just
# documents what can be set.
ANTHROPIC_API_KEY=sk-ant-...
# SYLABIS_HOME=~/sylabis          # where your journey lives
# SYLABIS_MODEL=claude-sonnet-4-6 # override the model id
